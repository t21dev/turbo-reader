{
  "name": "turbo-reader-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Website for Turbo Reader (turbo-reader.t21.dev). Prerendered React, served by Cloudflare Workers static assets.",
  "scripts": {
    "dev": "node scripts/release.mjs && vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/release.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "og": "node scripts/og.mjs",
    "check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.40.0"
  }
}
